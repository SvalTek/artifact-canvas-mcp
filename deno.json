{
  "lock": false,
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check main.ts dev.ts fresh.config.ts fresh.gen.ts web.ts routes/_app.tsx routes/_404.tsx routes/mcp.ts routes/index.tsx routes/greet/[name].tsx routes/events.ts routes/api/joke.ts routes/api/artifacts/index.ts routes/api/artifacts/[id].ts islands/Counter.tsx islands/ArtifactCanvas.tsx components/Button.tsx components/ArtifactContent.tsx lib/artifacts.ts lib/artifacts_test.ts lib/markdown.ts lib/markdown_test.ts lib/mcp_guidance.ts",
    "cli": "echo \"import '\\$fresh/src/dev/cli.ts'\" | deno run --unstable -A -",
    "manifest": "deno task cli manifest $(pwd)",
    "start": "deno run -A --watch=static/,routes/ dev.ts",
    "mcp": "deno run -A main.ts",
    "build": "deno run -A dev.ts build",
    "preview": "deno run -A web.ts",
    "update": "deno run -A -r https://fresh.deno.dev/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "@preact/signals": "https://esm.sh/*@preact/signals@1.2.2",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.5.1",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "tailwindcss/": "npm:/tailwindcss@3.4.1/",
    "tailwindcss/plugin": "npm:/tailwindcss@3.4.1/plugin.js",
    "daisyui": "npm:daisyui@4.12.24",
    "markdown-it": "npm:markdown-it@14.1.0",
    "markdown-it-task-lists": "npm:markdown-it-task-lists@2.1.1",
    "$std/": "https://deno.land/std@0.216.0/"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "nodeModulesDir": "auto"
}
